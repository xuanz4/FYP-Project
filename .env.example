# Copy this file to .env and fill in real values. .env is gitignored and never committed.
# Whatever hosting you use (Render, a VPS, etc.), these are the exact variables to set in
# its environment-variables dashboard - this file is the checklist either way.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# On your own local MySQL (DB_AUTO_CREATE unset/true below): must be exactly this value -
# FYP_Transaction_Monitoring.sql hardcodes this database name when it creates it.
# On a shared server (DB_AUTO_CREATE=false, e.g. Azure): set this to whatever database name
# was actually assigned to you there instead - it does not need to be this value.
DB_NAME=fyp_transaction_monitoring

# Leave unset (or "true") on your own local MySQL - db:init will drop/recreate DB_NAME fresh
# each time, same as always.
# Set to "false" on a shared/managed server (e.g. a lecturer-provisioned Azure MySQL database)
# where the database already exists and your login cannot create or drop databases. This skips
# the DROP DATABASE/CREATE DATABASE step and builds the tables directly inside DB_NAME instead.
DB_AUTO_CREATE=true

# Leave unset on your own local MySQL. Set to "true" for a managed host that requires SSL
# (e.g. Azure Database for MySQL almost always does). If you get a self-signed/unrecognised-CA
# connection error and have no CA certificate to configure instead, you can set
# DB_SSL_REJECT_UNAUTHORIZED=false as a last resort - it skips certificate verification.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Session ---
# Any long random string. Used to sign login session cookies.
SESSION_SECRET=change-this-to-a-random-string

# --- Server ---
PORT=3000

# --- Outbound email (RFI messages to merchants) ---
SMTP_HOST=smtp.gmail.com
# Optional when SMTP_HOST is an IP address: keep this as the provider hostname so
# TLS certificate verification still checks the correct server identity.
SMTP_SERVERNAME=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-address@gmail.com
SMTP_FROM_NAME=UNIWEB Transaction Monitoring Team

# --- Inbound email (reading RFI replies) ---
# Optional if SMTP_USER/SMTP_PASS is a Gmail address - IMAP defaults to Gmail automatically.
# Set these explicitly if using a different mailbox provider.
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_PORT=993
IMAP_MAILBOX=INBOX
